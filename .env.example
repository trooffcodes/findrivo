# Copy to src/.env for local development. Never commit real credentials.
FINDRIVO_ENV=development
DEBUG=true
FLASK_PORT=2111

# Required for production API access. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FINDRIVO_API_TOKEN=
# Only enable this for local development. Production should require a token.
ALLOW_UNAUTHENTICATED=true

# LLM providers. At least one provider/key should be configured.
GEMINI_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
QWEN_VISION_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=45

# Pipeline limits
DEFAULT_LEAD_TARGET=10
MAX_TARGET_COUNT=25
MAX_ACTIVE_JOBS=2
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
STREAM_TTL_SECONDS=3600
REQUEST_TIMEOUT=8
LINK_CHECK_TIMEOUT=3.5
MAX_AUDIT_CONCURRENCY=4

# Discovery / browser
HEADLESS=true
CONCURRENCY=2
MAX_LEADS=20
DELAY_MIN=0.6
DELAY_MAX=1.4
PLAYWRIGHT_NO_SANDBOX=false
RESUME_DISCOVERY=false

# Persistence. Lead snapshots are stored under FINDRIVO_RESULTS_DIR and kept
# for RESULTS_RETENTION_HOURS before automatic pruning (default 24).
FINDRIVO_RESULTS_DIR=data/jobs
RESULTS_RETENTION_HOURS=24

# Browser fallback (Playwright). Only used for promising, live websites with
# important contact data still missing after lightweight HTTP extraction.
BROWSER_FALLBACK_ENABLED=true
BROWSER_FALLBACK_TIMEOUT=15
BROWSER_FALLBACK_MAX_PER_JOB=15

# Storage. Relative paths resolve against the repository root.
FINDRIVO_LOG_DIR=logs
FINDRIVO_EXPORT_DIR=exports
PROGRESS_FILE=discovery_progress.json
